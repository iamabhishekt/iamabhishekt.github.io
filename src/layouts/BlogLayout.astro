---
import Head from '../components/Head.astro'
import '../blog/blog.css'

interface Props {
  title: string
  description: string
  type?: 'website' | 'article'
}

const { title, description, type } = Astro.props
---

<html lang="en">
  <head>
    <Head title={title} description={description} type={type} />
    <script is:inline>
      // Before first paint, so a stored choice never flashes the other theme.
      try {
        const saved = localStorage.getItem('theme')
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved
      } catch {}
    </script>
  </head>
  <body class="blog">
    <header class="site-head">
      <a class="site-name" href="/">Abhishek Thakur</a>
      <nav aria-label="Site">
        <a href="/blog/">Devlog</a>
        <a href="https://github.com/iamabhishekt">GitHub</a>
        <a href="/rss.xml">RSS</a>
        <button class="theme-toggle" type="button" aria-label="Switch theme">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
          </svg>
        </button>
      </nav>
    </header>
    <slot />
    <footer class="site-foot">
      <span class="torn foot-strip" aria-hidden="true"></span>
      <p>Written in Markdown, pushed to GitHub, live a minute later.</p>
      <p><a href="/">Home</a> · <a href="/blog/">Devlog</a> · <a href="/rss.xml">RSS</a></p>
    </footer>
    <script>
      import { setupThemeToggle } from '../blog/theme'
      setupThemeToggle()
    </script>
  </body>
</html>
